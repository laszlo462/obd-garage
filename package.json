{
  "name": "obd-garage",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node scripts/dev.ts",
    "build": "vite build",
    "check:bundle": "node scripts/check-bundle-origins.ts",
    "check:slice": "node --no-warnings scripts/check-slice.ts",
    "start": "node src/server/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "reparse": "node src/server/reparse.ts"
  },
  "dependencies": {
    "@fontsource/inter": "5.3.0",
    "@fontsource/roboto-mono": "5.3.0",
    "@hono/node-server": "2.1.5",
    "@preact/signals": "2.11.4",
    "better-sqlite3": "13.0.3",
    "fflate": "0.8.3",
    "hono": "4.13.14",
    "linkedom": "0.18.14",
    "lucide-preact": "1.66.0",
    "preact": "11.1.1",
    "preact-iso": "2.12.2",
    "preact-render-to-string": "6.8.2",
    "uplot": "1.6.32"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@preact/preset-vite": "2.10.6",
    "@testing-library/dom": "10.4.2",
    "@testing-library/preact": "3.2.6",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "24.19.2",
    "@vitest/coverage-v8": "5.0.5",
    "happy-dom": "21.0.4",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
